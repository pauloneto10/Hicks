{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "hicks-burger.vercel.app"
        }
      ],
      "destination": "https://hicksburger.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/portlink",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/portlink",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/portlink",
      "permanent": true
    },
    {
      "source": "/historia",
      "destination": "/hamburgueria-autoral-campinas",
      "permanent": true
    },
    {
      "source": "/bastidores",
      "destination": "/portlink#cozinha",
      "permanent": true
    },
    {
      "source": "/central",
      "destination": "/portlink#acesso",
      "permanent": true
    },
    {
      "source": "/qual-hamburguer-escolher",
      "destination": "/cardapio",
      "permanent": true
    },
    {
      "source": "/hamburguer-de-frango-crocante",
      "destination": "/cardapio",
      "permanent": true
    },
    {
      "source": "/hamburgueria-aberta-a-noite-campinas",
      "destination": "/portlink#acesso",
      "permanent": true
    },
    {
      "source": "/hamburguer-angus",
      "destination": "/melhor-angus-de-campinas",
      "permanent": true
    },
    {
      "source": "/horarios-e-entrega",
      "destination": "/portlink#acesso",
      "permanent": true
    },
    {
      "source": "/burgers",
      "destination": "/cardapio",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(img|cardapio|burgers|fonts|video)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon-32.png|icon-192.png|icon-512.png|apple-touch-icon.png|og.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self' https://audio-ssl.itunes.apple.com; connect-src 'self' https://itunes.apple.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
